# ============================================================
# STOCKSENSE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================
# Copy this file to '.env' and fill in your actual configuration values.
# NEVER commit the actual '.env' file to your Git repository.

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Security & JWT Authentication
# Replace with a strong, random secret key (e.g., generate via: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
STOCKSENSE_SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite database file path:
DATABASE_PATH=data/smartstock.db
SMARTSTOCK_DB_PATH=data/smartstock.db

# Optional Production Database URL (e.g., PostgreSQL for cloud deployments):
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Host & Port
HOST=127.0.0.1
PORT=8000
VITE_API_BASE_URL=http://localhost:8000/api
